# Endereço do site do desenvolvedor, usado no link da logo do rodapé ("Desenvolvido por")
VITE_DEVELOPER_URL=https://www.nexmind.net.br

# Caminho público onde o build fica (backend/public/app). Ajuste se o sistema rodar em subpasta.
VITE_BASE=/app/

# URL base da API. Em produção, mesma origem do frontend (/api).
VITE_API_URL=/api

# Destino do proxy /api no "npm run dev"
VITE_API_PROXY=http://127.0.0.1:8000

# Caminho base das rotas do navegador. Use "/" com virtual host (recomendado).
# Em subpasta do XAMPP, ex.: /sic-selc/backend/public
VITE_ROUTER_BASE=/
